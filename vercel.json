{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(auth|welcome|today|settings|teams|players|associations|join|guardian|team|association|solo|unsubscribe)(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/_private/auth.html" },
    { "source": "/join", "destination": "/_private/join.html" },
    { "source": "/join/:path*", "destination": "/_private/join.html" },
    { "source": "/guardian/join/:path*", "destination": "/_private/guardianInvite.html" },
    { "source": "/team/adult/join/:path*", "destination": "/_private/teamStaffInvite.html" },
    { "source": "/association/join/:path*", "destination": "/_private/associationInvite.html" },
    { "source": "/solo/try/:path*", "destination": "/_private/sharedWorkout.html" },
    { "source": "/unsubscribe/:path*", "destination": "/_private/unsubscribe.html" },
    { "source": "/features", "destination": "/features/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/demo", "destination": "/demo/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
